#!/bin/bash
#PBS -N p2_phasef
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o outputs/p2/pbs/
# P2 Phase F (optional): DiT or VAR on real microscopy images (lanes/p2/transfer.py). Codec reconstruction
# check, then for each start: DiT, the real latent noised to that timestep and denoised (cfg 1);
# VAR (MODEL=var), the real tokens at scales 0..start and the rest generated by VAR-d20 (cfg 0).
#     qsub -P <your-project-id> -v REAL_DIR=data/dibas_subset lanes/p2/jobs/phasef.pbs
#     qsub -P <your-project-id> -v REAL_DIR=data/crystal_16,STARTS=96+297+497,CORRUPT=197:1.0 lanes/p2/jobs/phasef.pbs
#     qsub -P <your-project-id> -v REAL_DIR=data/crystal_64,STARTS=197,CORRUPT=96:0.5+96:1.0+36:1.0,CLASS_ID=973 \
#          lanes/p2/jobs/phasef.pbs
#     qsub -P <your-project-id> -v MODEL=var,REAL_DIR=data/crystal_16,STARTS=1+3+5+9,CORRUPT=6:1.0+8:1.0 \
#          lanes/p2/jobs/phasef.pbs                           # VAR: STARTS / CORRUPT stages are scales
# REAL_DIR: a folder of images (a multiple of 16; e.g. 2 per DIBaS species), prepared on the login node.
set -uo pipefail
[[ -n "${PBS_JOBID:-}" ]] || { echo "submit with qsub; no GPU work on the login node" >&2; exit 1; }
cd "$PBS_O_WORKDIR"
[[ -f runner/generate.py ]] || { echo "submit from the repo root" >&2; exit 1; }
[[ -d "${REAL_DIR:-}" ]] || { echo "set REAL_DIR to a folder of images" >&2; exit 1; }

STARTS="${STARTS:-36 96 197 297 497 798}"   # DiT timesteps to start from (timestep_in values); with qsub -v
STARTS="${STARTS//+/ }"                      # separate them with + (96+297+497), as -v splits on commas
CORRUPT="${CORRUPT:-}"   # optional "stage:severity" list joined by +, e.g. "96:0.5+96:1.0": also run each start
CORRUPT="${CORRUPT//+/ }" # with noise_x there (P2_SCALE=sigma), compared with the uncorrupted run from that start
CLASS_ID="${CLASS_ID:-0}" # the ImageNet class every row is conditioned on (the model pulls towards it)
KEEP_RAW="${KEEP_RAW:-0}" # 1: keep the raw .pt tensors
MODEL="${MODEL:-dit}"
if [[ "$MODEL" == var ]]; then CONFIG=lanes/p2/jobs/var_cfg0.yaml REAL_HOOK=real_h NOISE_HOOK=noise_h
else CONFIG=lanes/p2/jobs/dit_cfg1.yaml REAL_HOOK=real_x NOISE_HOOK=noise_x; fi
OUT="outputs/p2/phasef/${PBS_JOBID%%.*}_$MODEL"
mkdir -p "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1

set +u
module load miniforge3
eval "$(conda shell.bash hook)"
conda activate var-dit
set -u
export PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 P2_REAL_DIR="$REAL_DIR" P2_REAL_MANIFEST="$OUT/manifest.csv"
FAILED=0

python -m lanes.p2.transfer manifest "$REAL_DIR" --out "$OUT/manifest.csv" --class-id "$CLASS_ID" \
    && python -m lanes.p2.transfer recon "$REAL_DIR" --out "$OUT/recon" --model "$MODEL" || exit 1
for t in $STARTS; do
    echo "== start at timestep $t"
    P2_REAL_STAGE="$t" python -m runner.generate --config "$CONFIG" --manifest "$OUT/manifest.csv" \
        --batch-size 16 --allow-partial-batch --out-dir "$OUT/t$t" --hook "lanes/p2/transfer.py:$REAL_HOOK" \
        && python -m lanes.p2.transfer score "$OUT/t$t" --real-dir "$REAL_DIR" --manifest "$OUT/manifest.csv" \
        || { echo "FAILED: t$t"; FAILED=1; continue; }
    for c in $CORRUPT; do
        cs="${c%%:*}" sev="${c##*:}"
        # the corruption must come after the start: a lower DiT timestep, a higher VAR scale
        if [[ "$MODEL" == var ]]; then (( cs > t )) || continue; else (( t > cs )) || continue; fi
        arm="t${t}_noise_s${cs}_sev${sev}"
        echo "== $arm"
        P2_REAL_STAGE="$t" P2_STAGE="$cs" P2_SEVERITY="$sev" P2_SCALE="$([[ $MODEL == var ]] && echo rel || echo sigma)" python -m runner.generate \
            --config "$CONFIG" --manifest "$OUT/manifest.csv" --batch-size 16 --allow-partial-batch \
            --out-dir "$OUT/$arm" --hook "lanes/p2/transfer.py:$REAL_HOOK" --hook "lanes/p2/hooks.py:$NOISE_HOOK" \
            && python -m lanes.p2.analyze images "$OUT/$arm" --baseline "$OUT/t$t" \
            && python -m lanes.p2.transfer score "$OUT/$arm" --real-dir "$REAL_DIR" --manifest "$OUT/manifest.csv" \
            || { echo "FAILED: $arm"; FAILED=1; }
    done
done
[[ "$KEEP_RAW" == 1 ]] || find "$OUT" -mindepth 2 -maxdepth 2 -name '*.pt' -delete
echo "code: $(git rev-parse --abbrev-ref HEAD) $(git log -1 --oneline)"
if [[ "$FAILED" == 0 ]]; then echo "PHASE F DONE"; else echo "PHASE F FAILED: see above"; fi
exit "$FAILED"
