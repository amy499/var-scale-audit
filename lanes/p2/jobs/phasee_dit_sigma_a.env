# Phase E1, part a of 2: DiT with severity in units of the step's own noise level (P2_SCALE=sigma).
# Control for the "rel" severity: early latents are mostly noise, so the same fraction of signal is a
# small change there and a large one late. If DiT's tolerance is flat across steps under "sigma", the
# Phase C decline was mechanical; if it still falls, late steps really recover less.
# Timesteps 798 598 497 397 x severity 0.5, 1, 2 = 12 runs + baseline, ~100 min.
#     qsub -P <your-project-id> -l walltime=03:00:00 -v SETTINGS=lanes/p2/jobs/phasee_dit_sigma_a.env lanes/p2/jobs/pilot.pbs
MANIFEST=manifest/frozen_v1_1.csv
EXP_TAG=phasee
QUALITY=1
RUN_VAR=0
RUN_DIT=1
DIT_STAGES="798 598 497 397"
DIT_SEVERITIES="0.5 1.0 2.0"
export P2_SCALE=sigma
