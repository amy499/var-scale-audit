#!/bin/bash
#PBS -N p4_pilot_dit
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o outputs/p4/pbs/
# P4 Gate B pilot, DiT half (docs/HANDOVER.md 5; shape from scripts/examples/experiment.pbs).
# Submit from the repo root with P4's own project, never P1's:
#     qsub -P <your-project-id> lanes/p4/jobs/pilot_dit.pbs
# then confirm:  qstat -f <JOBID> | grep -i project     (qdel if it is not your project)
#
# 10 runs: the no-hook baseline first, then protect / damage / control at m = 25, 50, 75 steps
# (m/n = 0.1, 0.2, 0.3 of the 250 steps) via --skip-timesteps, batch 16, one batch per run.
# Walltime: DiT is 31.9 s per batch of 16 (docs/HANDOVER.md 5), so one batch is ~32 s at m = 0 and
# less for the arms, which evaluate fewer steps; model load dominates at ~2 min per process.
# 10 processes -> ~25 min. 2 h leaves headroom and keeps the job inside the <= 2 h band.
# DiT dominates the whole lane's budget: size any sweep from the 31.9 s number, not from VAR's.
set -uo pipefail
[[ -n "${PBS_JOBID:-}" ]] || { echo "submit with qsub; no GPU work on the login node" >&2; exit 1; }
cd "$PBS_O_WORKDIR"
[[ -f runner/generate.py ]] || { echo "submit from the repo root" >&2; exit 1; }

CONFIG="${DIT_CONFIG:-configs/dit_xl2_256.yaml}"
MANIFEST="${MANIFEST:-manifest/provisional_4x4.csv}"   # switch to P3's frozen manifest once it exists
BAND="${BAND:-middle}"
JOB="${PBS_JOBID%%.*}"
OUT="${OUT_ROOT:-outputs/p4}/pilot_dit/$JOB"
mkdir -p "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1

set +u
module load miniforge3
module load git/2.39.2
eval "$(conda shell.bash hook)"
conda activate var-dit
set -u
export PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1

nvidia-smi
python scripts/check_third_party.py
git log -1 --oneline              # run.json records the submodules, not this repo's branch
python -m lanes.p4.pilot run --model dit --band "$BAND" --config "$CONFIG" \
    --manifest "$MANIFEST" --out-root "$OUT"
python lanes/p4/verify_pairing.py "$OUT"
