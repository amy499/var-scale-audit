#!/bin/bash
#PBS -N p4_sweep_dit
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=05:00:00
#PBS -j oe
#PBS -o outputs/p4/pbs/
# P4 Phase C/E sweep, DiT half: baseline + protect/damage/control x 3 bands x 3 budgets, then pairing,
# then scoring, in one job. 28 runs, ~3.5 h (~330-470 s per run on 224 images, plus scoring).
# Submit from the repo root with P4's own project, never P1's (lanes/p4/RUNBOOK.md section B5):
#     qsub -P <your-project-id> lanes/p4/jobs/sweep_dit.pbs                                  # Phase C
#     qsub -P <your-project-id> -v SEED=20261070 lanes/p4/jobs/sweep_dit.pbs                 # Phase E seed 2
# then confirm:  qstat -f <JOBID> | grep -i project     (qdel if it is not your project)
# Overrides (CONFIG, SEED, OUT_TAG, STAGES, MANIFEST, KEEP_RAW) are documented in sweep_body.sh.
# Ends with exactly one of: P4 SWEEP COMPLETE, PAIRED AND SCORED   /   P4 SWEEP FAILED (...)
set -uo pipefail
[[ -n "${PBS_JOBID:-}" ]] || { echo "submit with qsub; no GPU work on the login node" >&2; exit 1; }
cd "$PBS_O_WORKDIR"
[[ -f runner/generate.py ]] || { echo "submit from the repo root" >&2; exit 1; }

set +u
module load miniforge3
module load git/2.39.2
eval "$(conda shell.bash hook)"
conda activate var-dit
set -u
export PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1

MODEL=dit JOB="${PBS_JOBID%%.*}" MACHINE=nscc
source lanes/p4/jobs/sweep_body.sh
