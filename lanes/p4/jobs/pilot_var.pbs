#!/bin/bash
#PBS -N p4_pilot_var
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o outputs/p4/pbs/
# P4 Gate B pilot, VAR half (docs/HANDOVER.md 5; shape from scripts/examples/experiment.pbs).
# Submit from the repo root with P4's own project, never P1's:
#     qsub -P <your-project-id> lanes/p4/jobs/pilot_var.pbs
# then confirm:  qstat -f <JOBID> | grep -i project     (qdel if it is not your project)
#
# Uses the frozen 224-image manifest by default. 10 runs: baseline, then protect / damage / control
# at m = 1, 2, 3 scales (0.1, 0.2, 0.3 of 10 scales), lambda = 0, batch size 16.
# Runtime estimates based on the old 16-image provisional manifest do not apply to this full run.
set -uo pipefail
[[ -n "${PBS_JOBID:-}" ]] || { echo "submit with qsub; no GPU work on the login node" >&2; exit 1; }
cd "$PBS_O_WORKDIR"
[[ -f runner/generate.py ]] || { echo "submit from the repo root" >&2; exit 1; }

CONFIG="${VAR_CONFIG:-configs/var_d20.yaml}"
MANIFEST="${MANIFEST:-manifest/frozen_v1_1.csv}"
BAND="${BAND:-middle}"
JOB="${PBS_JOBID%%.*}"
OUT="${OUT_ROOT:-outputs/p4}/pilot_var/$JOB"
mkdir -p "$OUT"
exec > >(tee -a "$OUT/job.log") 2>&1

set +u
module load miniforge3
module load git/2.39.2
eval "$(conda shell.bash hook)"
conda activate var-dit
set -u
export PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1

nvidia-smi
python scripts/check_third_party.py
git log -1 --oneline              # run.json records the submodules, not this repo's branch
# Exit codes are captured rather than ignored: without this the job's status is verify_pairing's
# alone, so a sweep that lost arms partway could still finish green.
python -m lanes.p4.pilot run --model var --band "$BAND" --config "$CONFIG" \
    --manifest "$MANIFEST" --out-root "$OUT"
PILOT_RC=$?
[[ $PILOT_RC -eq 0 ]] || echo "PILOT INCOMPLETE (exit $PILOT_RC) - verifying what exists, then failing"
python lanes/p4/verify_pairing.py "$OUT"
PAIR_RC=$?

if [[ $PILOT_RC -eq 0 && $PAIR_RC -eq 0 ]]; then
    echo "P4 PILOT COMPLETE AND PAIRED"
    exit 0
fi
echo "P4 PILOT FAILED (pilot exit $PILOT_RC, pairing exit $PAIR_RC) - do not use these runs"
exit 1
