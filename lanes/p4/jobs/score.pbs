#!/bin/bash
#PBS -N p4_score
#PBS -q normal
#PBS -l select=1:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o outputs/p4/pbs/
# P4 scoring, standalone: the recovery path for a root whose in-job scoring step failed.
# The sweep jobs already score in-job (lanes/p4/jobs/sweep_*.pbs), so this is not needed normally.
# Submit from the repo root with P4's own project, never P1's:
#     qsub -P <your-project-id> -v ROOTS="outputs/p4/full/var/seed1/<JOBID>" lanes/p4/jobs/score.pbs
# then confirm:  qstat -f <JOBID> | grep -i project     (qdel if it is not your project)
#
# KEEP_RAW=1 keeps the .pt tensors. Resumable: runs that already have every metric are skipped.
set -uo pipefail
[[ -n "${PBS_JOBID:-}" ]] || { echo "submit with qsub; no GPU work on the login node" >&2; exit 1; }
cd "$PBS_O_WORKDIR"
[[ -f runner/generate.py ]] || { echo "submit from the repo root" >&2; exit 1; }
[[ -n "${ROOTS:-}" ]] || { echo "set ROOTS to one or more P4 roots (qsub -v ROOTS=...)" >&2; exit 1; }

JOB="${PBS_JOBID%%.*}"
mkdir -p outputs/p4/pbs
exec > >(tee -a "outputs/p4/pbs/score_$JOB.log") 2>&1

set +u
module load miniforge3
module load git/2.39.2
eval "$(conda shell.bash hook)"
conda activate var-dit
set -u
export PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 KEEP_RAW="${KEEP_RAW:-0}"

nvidia-smi
git log -1 --oneline
# shellcheck disable=SC2086  # ROOTS is a space-separated list on purpose
python -m lanes.p4.score $ROOTS
exit $?
