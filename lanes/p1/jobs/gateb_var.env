# Gate B, VAR: clean baseline + remove the mid scales {3,4,5} (variant b) on manifest v1.1 (224 images),
# with quality scores. Early {0,1,2} and late {7,8,9} arms are added here once mid is checked.
#     qsub -v SETTINGS=lanes/p1/jobs/gateb_var.env lanes/p1/jobs/gateb.pbs
#     qsub -v SETTINGS=lanes/p1/jobs/gateb_var.env,P3_RIDEALONG=1 lanes/p1/jobs/gateb.pbs   # + P3 observe hook
# Outputs: outputs/p1/<JOBID>/. The baseline must match outputs/baseline/25665469/var_d20 row by row.
MANIFEST=manifest/frozen_v1_1.csv
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_mid:3,4,5"
QUALITY=1
