# Necessity sweep, DiT: clean baseline + skip the early 1-83, mid 84-166 and late 167-249 steps (83 each,
# burn kept) on manifest v1.1 (224 images), with quality scores. Step 0 is never cut.
#     qsub -v SETTINGS=lanes/p1/jobs/sweep_dit.env lanes/p1/jobs/gateb.pbs
# Estimated: ~486 s baseline + 3 x ~330 s arms + ~20 s scoring per run = ~26 min (+ job start-up).
# The step indices become timesteps through this job's own baseline run.json (stages table).
# Outputs: outputs/p1/<JOBID>/. The baseline must match outputs/baseline/25665469/dit row by row.
MANIFEST=manifest/frozen_v1_1.csv
EXP_TAG=sweep
RUN_VAR=0
RUN_DIT=1
DIT_ARMS="remove_early:1-83 remove_mid:84-166 remove_late:167-249"
QUALITY=1
