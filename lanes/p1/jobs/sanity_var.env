# Positive control for lanes/p1/hooks.py, VAR: clean baseline + remove scale 9 alone, then scale 0 alone,
# on manifest v1.1 (224 images), with quality scores. Removing scale 9 should leave a near-normal dog; if
# it does not, the hook is wrong and no VAR removal result is valid (lanes/p1/README.md, "Controls").
#     qsub -v SETTINGS=lanes/p1/jobs/sanity_var.env lanes/p1/jobs/gateb.pbs
# Estimated: ~76 s baseline + 2 x ~40 s arms + ~20 s scoring per run = ~4 min (+ job start-up).
# Outputs: outputs/p1/<JOBID>/. The baseline must match outputs/baseline/25665469/var_d20 row by row.
MANIFEST=manifest/frozen_v1_1.csv
EXP_TAG=sanity
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_s9:9 remove_s0:0"
VAR_CUT=1          # single-scale arms: this file only; gateb.pbs keeps its default of 3
P3_RIDEALONG=0
QUALITY=1
