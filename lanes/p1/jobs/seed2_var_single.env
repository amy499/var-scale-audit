# Phase E, second seed set, VAR: clean baseline + remove each of scales 0-9 alone (variant b) on
# lanes/p1/manifests/seed2.csv (same 7 classes x 32, master seed 61320018), with quality scores.
#     qsub -v SETTINGS=lanes/p1/jobs/seed2_var_single.env lanes/p1/jobs/gateb.pbs
# Estimated (from 25916920's steps.tsv): ~70 s baseline + 10 x ~38 s arms incl. scoring = ~8 min (+ start-up).
# BASELINE_REF points at a path that does not exist on purpose: outputs/baseline/25665469 holds the seed-1
# images, and no reference baseline exists for these seeds, so the hash check reports SKIPPED (not a failure
# in gateb.pbs). This job's own baseline becomes the seed-2 reference.
MANIFEST=lanes/p1/manifests/seed2.csv
BASELINE_REF=outputs/baseline/none_for_seed2
EXP_TAG=seed2single
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_s0:0 remove_s1:1 remove_s2:2 remove_s3:3 remove_s4:4 remove_s5:5 remove_s6:6 remove_s7:7 remove_s8:8 remove_s9:9"
VAR_CUT=1          # single-scale arms
P3_RIDEALONG=0
QUALITY=1
KEEP_RAW=0         # delete raw tensors once each run is scored (lanes/p1/README.md, "Raw tensors")
