# Sliding window of 2, VAR: clean baseline + remove each pair of neighbouring scales (variant b) on
# manifest v1.1 (224 images), with quality scores. Raw tensors are deleted once each run is scored.
#     qsub -v SETTINGS=lanes/p1/jobs/window2_var.env lanes/p1/jobs/gateb.pbs
# Estimated: ~76 s baseline + 9 x ~40 s arms + ~20 s scoring per run = ~11 min (+ job start-up).
# Outputs: outputs/p1/<JOBID>/. The baseline must match outputs/baseline/25665469/var_d20 row by row.
MANIFEST=manifest/frozen_v1_1.csv
EXP_TAG=window2
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_s01:0,1 remove_s12:1,2 remove_s23:2,3 remove_s34:3,4 remove_s45:4,5 remove_s56:5,6 remove_s67:6,7 remove_s78:7,8 remove_s89:8,9"
VAR_CUT=2          # two-scale arms: this file only; gateb.pbs keeps its default of 3
P3_RIDEALONG=0
QUALITY=1
KEEP_RAW=0
