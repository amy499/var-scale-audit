# Sliding window of 3, VAR: clean baseline + remove each run of 3 neighbouring scales not yet run
# (variant b) on manifest v1.1 (224 images), with quality scores. {0,1,2}, {3,4,5} and {7,8,9} ran in job
# 25893212 (sweep_var.env). Raw tensors are deleted once each run is scored.
#     qsub -v SETTINGS=lanes/p1/jobs/window3_var.env lanes/p1/jobs/gateb.pbs
# Estimated: ~76 s baseline + 5 x ~40 s arms + ~20 s scoring per run = ~7 min (+ job start-up).
# Outputs: outputs/p1/<JOBID>/. The baseline must match outputs/baseline/25665469/var_d20 row by row.
MANIFEST=manifest/frozen_v1_1.csv
EXP_TAG=window3
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_s123:1,2,3 remove_s234:2,3,4 remove_s456:4,5,6 remove_s567:5,6,7 remove_s678:6,7,8"
VAR_CUT=3
P3_RIDEALONG=0
QUALITY=1
KEEP_RAW=0
