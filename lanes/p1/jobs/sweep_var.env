# Necessity sweep, VAR: clean baseline + remove the early {0,1,2}, mid {3,4,5} and late {7,8,9} scales
# (variant b) on manifest v1.1 (224 images), with quality scores. Scale 6 is never cut.
#     qsub -v SETTINGS=lanes/p1/jobs/sweep_var.env lanes/p1/jobs/gateb.pbs
# Estimated: ~76 s baseline + 3 x ~40 s arms + ~20 s scoring per run = ~5 min (+ job start-up).
# Outputs: outputs/p1/<JOBID>/. The baseline must match outputs/baseline/25665469/var_d20 row by row.
MANIFEST=manifest/frozen_v1_1.csv
EXP_TAG=sweep
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_early:0,1,2 remove_mid:3,4,5 remove_late:7,8,9"
P3_RIDEALONG=0
QUALITY=1
