# Phase E, second seed set, VAR: clean baseline + remove the early {0,1,2}, mid {3,4,5} and late {7,8,9}
# groups (variant b) on lanes/p1/manifests/seed2.csv (same 7 classes x 32, master seed 61320018), with quality
# scores. Same arms as sweep_var.env (seed 1: job 25893212).
#     qsub -v SETTINGS=lanes/p1/jobs/seed2_var_groups.env lanes/p1/jobs/gateb.pbs
# Estimated (from 25893212 / 25916920 steps.tsv): ~70 s baseline + 3 x ~38 s arms incl. scoring = ~3 min
# (+ start-up).
# BASELINE_REF points at a path that does not exist on purpose: outputs/baseline/25665469 holds the seed-1
# images, and no reference baseline exists for these seeds, so the hash check reports SKIPPED (not a failure
# in gateb.pbs).
MANIFEST=lanes/p1/manifests/seed2.csv
BASELINE_REF=outputs/baseline/none_for_seed2
EXP_TAG=seed2groups
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_early:0,1,2 remove_mid:3,4,5 remove_late:7,8,9"
VAR_CUT=3
P3_RIDEALONG=0
QUALITY=1
KEEP_RAW=0
