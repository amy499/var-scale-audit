# Single-scale sweep, VAR: clean baseline + remove each of scales 1-8 alone (variant b) on manifest v1.1
# (224 images), with quality scores. Scales 0 and 9 alone already ran in job 25893211 (sanity_var.env).
#     qsub -v SETTINGS=lanes/p1/jobs/single_var.env lanes/p1/jobs/gateb.pbs
# Estimated: ~76 s baseline + 8 x ~40 s arms + ~20 s scoring per run = ~10 min (+ job start-up).
# Outputs: outputs/p1/<JOBID>/. The baseline must match outputs/baseline/25665469/var_d20 row by row.
MANIFEST=manifest/frozen_v1_1.csv
EXP_TAG=single
RUN_VAR=1
RUN_DIT=0
VAR_ARMS="remove_s1:1 remove_s2:2 remove_s3:3 remove_s4:4 remove_s5:5 remove_s6:6 remove_s7:7 remove_s8:8"
VAR_CUT=1          # single-scale arms: this file only; gateb.pbs keeps its default of 3
P3_RIDEALONG=0
QUALITY=1
KEEP_RAW=0         # delete raw tensors once each run is scored (lanes/p1/README.md, "Raw tensors")
